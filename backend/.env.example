# ============================================================
# DH_MIL backend - environment configuration
# Copy this file to ".env" and adjust the values for your setup.
# ============================================================

# --- Database -------------------------------------------------
# Default: local SQLite file, zero setup, good for development.
DATABASE_URL=sqlite:///./op_control.db
# Production example (matches database/schema.sql):
# DATABASE_URL=mysql+pymysql://op_control_user:password@localhost:3306/op_control

# --- Auth -------------------------------------------------------
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---------------------------------------------------------
# Comma separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Ground module (ESP32 rover: motors + ultrasonic sensor) ------
# Base URL of the ESP32 exposed in "New Microsoft Word Document.docx" (section 1).
# It serves plain HTTP routes: /avant /arriere /gauche /droite /stop
GROUND_MODULE_BASE_URL=http://192.168.4.1
GROUND_MODULE_TIMEOUT_SECONDS=2.0

# --- ESP32-CAM (video source) --------------------------------------
# Base URL of the ESP32-CAM described in the same document (section 2).
# It serves a single JPEG snapshot at GET /capture.
CAMERA_MODULE_BASE_URL=http://192.168.4.2
CAMERA_POLL_INTERVAL_SECONDS=0.2
CAMERA_ID=1

# --- Ground telemetry relay (ultrasonic + GPS) ----------------------
# GET {GROUND_MODULE_BASE_URL}/telemetrie -- see firmware/ground_module
TELEMETRY_POLL_INTERVAL_SECONDS=1.0

# Dead-man's switch: force-stop a drone that's still marked as moving
# but hasn't received a movement command in this many seconds (covers
# a dropped WebSocket / crashed frontend tab).
COMMAND_WATCHDOG_SECONDS=3.0

# When true (default), a drone the backend can't reach over WiFi keeps
# producing plausible simulated telemetry/video instead of going blank --
# handy for running the whole stack with no hardware plugged in yet.
# Set to false for a real deployment where "unreachable" should mean
# exactly that.
SIMULATION_MODE=true

# --- Obstacle avoidance (ultrasonic sensor) ------------------------
# Mirrors DISTANCE_SECURITE in the ESP32 firmware (centimeters).
OBSTACLE_SAFE_DISTANCE_CM=30.0

# --- YOLO object detection ------------------------------------------
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.4
# How often (in seconds) a captured frame is run through YOLO.
# Keeping this lower than the camera poll interval just re-analyzes the same frame.
YOLO_INFERENCE_INTERVAL_SECONDS=0.5
# Detections at/above this confidence for these classes auto-raise an "alerte" row.
ALERT_ON_CLASSES=person
ALERT_MIN_CONFIDENCE=0.6
